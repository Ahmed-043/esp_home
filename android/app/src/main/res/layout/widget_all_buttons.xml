<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ESP Home"
        android:textColor="#E5F4FF"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_relay_1"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_primary_button"
            android:gravity="center"
            android:text="RELAY1"
            android:textColor="#052D33"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_relay_alt_1"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="ALT"
            android:textColor="#D9F8FF"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_relay_2"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_primary_button"
            android:gravity="center"
            android:text="RELAY2"
            android:textColor="#052D33"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_relay_alt_2"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="ALT"
            android:textColor="#D9F8FF"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_relay_3"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_primary_button"
            android:gravity="center"
            android:text="RELAY3"
            android:textColor="#052D33"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_relay_alt_3"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="ALT"
            android:textColor="#D9F8FF"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_relay_4"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_primary_button"
            android:gravity="center"
            android:text="RELAY4"
            android:textColor="#052D33"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_relay_alt_4"
            android:layout_width="44dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="ALT"
            android:textColor="#D9F8FF"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_all_on"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_primary_button"
            android:gravity="center"
            android:text="ALL ON"
            android:textColor="#052D33"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_all_off"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="ALL OFF"
            android:textColor="#D9F8FF"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_set_time"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="SET TIME"
            android:textColor="#D9F8FF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_open_app"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_secondary_button"
            android:gravity="center"
            android:text="OPEN APP"
            android:textColor="#D9F8FF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
